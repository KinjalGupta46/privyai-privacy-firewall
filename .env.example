# ─────────────────────────────────────────────────────────────────────────────
# PrivyAI Backend — Environment Variable Template
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# This file (.env.example) contains only placeholder values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="PrivyAI Backend"
APP_VERSION="0.1.0"
DEBUG=false

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API.
# Example: http://localhost:3000,https://your-frontend.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database (PostgreSQL) ──
# Format: postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql+psycopg://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/privyai_db

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: mock | openai | gemini | anthropic
# Use "mock" for local development without a real API key.
LLM_PROVIDER=mock

# OpenAI (uncomment and fill if using OpenAI)
# OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=                    # leave blank for the default OpenAI endpoint

# Google Gemini (uncomment and fill if using Gemini)
# GEMINI_API_KEY=REPLACE_WITH_YOUR_KEY
# GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude (uncomment and fill if using Anthropic)
# ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_KEY
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# Timeout for LLM API calls (seconds)
LLM_TIMEOUT=30

# ── Privacy Pipeline ──────────────────────────────────────────────────────────
# Presidio detection confidence threshold (0.0–1.0).
# Entities with confidence below this value are ignored.
PII_CONFIDENCE_THRESHOLD=0.5

# Risk score thresholds:
#   score < RISK_ALLOW_THRESHOLD  → ALLOW
#   score < RISK_REDACT_THRESHOLD → REDACT
#   score >= RISK_REDACT_THRESHOLD → BLOCK
RISK_ALLOW_THRESHOLD=0.3
RISK_REDACT_THRESHOLD=0.7

# ── File Upload Limits ────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
MAX_MESSAGE_LENGTH=10000

# ── Storage Adapter ───────────────────────────────────────────────────────────
# "local" uses a local tmp folder for development only.
# Replace with your team's adapter when available.
STORAGE_ADAPTER=local
LOCAL_STORAGE_PATH=tmp_uploads
